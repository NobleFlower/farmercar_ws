<launch>
  <include file="$(find velocity_adapter)/launch/adapter.launch">
    <arg name="input_topic" value="/adapter_test/plain_input"/>
    <arg name="output_topic" value="/adapter_test/plain_mapped"/>
    <arg name="status_topic" value="/adapter_test/plain_status"/>
  </include>
  <include file="$(find tricycle_controller)/launch/controller.launch">
    <arg name="input_stamped" value="true"/>
    <arg name="input_topic" value="/adapter_test/plain_mapped"/>
    <arg name="output_topic" value="/adapter_test/plain_command"/>
    <arg name="achievable_topic" value="/adapter_test/plain_achievable"/>
    <arg name="status_topic" value="/adapter_test/plain_chassis_status"/>
  </include>
  <group ns="stamped">
    <include file="$(find velocity_adapter)/launch/adapter.launch">
      <arg name="input_topic" value="/adapter_test/stamped_input"/>
      <arg name="input_stamped" value="true"/>
      <arg name="output_topic" value="/adapter_test/stamped_mapped"/>
      <arg name="status_topic" value="/adapter_test/stamped_status"/>
    </include>
    <include file="$(find tricycle_controller)/launch/controller.launch">
      <arg name="input_stamped" value="true"/>
      <arg name="input_topic" value="/adapter_test/stamped_mapped"/>
      <arg name="output_topic" value="/adapter_test/stamped_command"/>
      <arg name="achievable_topic" value="/adapter_test/stamped_achievable"/>
      <arg name="status_topic" value="/adapter_test/stamped_chassis_status"/>
    </include>
  </group>
  <test pkg="velocity_adapter" type="test_ros_adapter.py" test-name="adapter" time-limit="45"/>
</launch>
